# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by the app at runtime.
#
# On a serverless host (Vercel), use your provider's POOLED connection string. Each function
# instance opens its own connections, and the direct endpoint runs out of them under load.
#   Neon:     the host containing "-pooler"
#   Supabase: the Supavisor string on port 6543
DATABASE_URL="postgresql://user:password@host:5432/hiring_portal"

# Optional, but strongly recommended when DATABASE_URL is pooled: the DIRECT connection string.
# Migrations run against this instead, because DDL over a transaction pooler fails on advisory
# locks and prepared statements. Used only by `prisma migrate` — never by the running app.
# Leave unset if you have a single, non-pooled database (e.g. local development).
DIRECT_DATABASE_URL=""

# Signs session cookies. Generate with: openssl rand -base64 48
# Changing this signs everyone out.
SESSION_SECRET="change-me-to-at-least-32-random-characters"

# Public URL of this deployment. Used in invite links and the Apps Script snippet.
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Resume storage — any S3-compatible bucket (Cloudflare R2, Supabase Storage, MinIO, AWS S3)
# Without these, agencies can still submit candidates but can't attach resumes.
# ---------------------------------------------------------------------------

S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="hiring-portal-resumes"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Most S3-compatible providers other than AWS need path-style addressing.
S3_FORCE_PATH_STYLE="true"

# ---------------------------------------------------------------------------
# Email (Resend) — invites, password resets, stage notifications
# Without a key, emails are recorded in the email_log table as SKIPPED and the UI
# offers a copyable invite link instead.
# ---------------------------------------------------------------------------

RESEND_API_KEY=""
EMAIL_FROM="Hiring Portal <hiring@yourdomain.com>"

# ---------------------------------------------------------------------------
# Google Sheets — importing website leads
# Create a service account, enable the Google Sheets API, then share your leads
# spreadsheet with the service account email (viewer access is enough).
# ---------------------------------------------------------------------------

GOOGLE_SERVICE_ACCOUNT_EMAIL="portal@your-project.iam.gserviceaccount.com"
# Paste the whole private key including the BEGIN/END lines. Literal \n is handled.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Shared secrets for machine-to-machine routes
# Generate each with: openssl rand -hex 32
# ---------------------------------------------------------------------------

# Sent by the Apps Script in the X-Portal-Secret header.
SHEETS_WEBHOOK_SECRET=""
# Sent by Vercel Cron in the Authorization header.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Seed script (optional) — first admin account created by `npm run db:seed`
# ---------------------------------------------------------------------------

SEED_ADMIN_EMAIL="you@yourcompany.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Portal Admin"

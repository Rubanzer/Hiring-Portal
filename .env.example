# ---------------------------------------------------------------------------
# Set these on the deployment. Nine variables, plus one optional.
#
# Locally, copy this file to .env and fill in what you need — the app boots on
# DATABASE_URL and SESSION_SECRET alone.
# ---------------------------------------------------------------------------

# --- Database (Neon, Supabase, or any PostgreSQL) --------------------------

# The connection string the app uses at runtime.
#
# On a serverless host, use your provider's POOLED string. Each function instance opens its own
# connections and the direct endpoint runs out of them under load.
#   Neon:     the host containing "-pooler"
#   Supabase: the Supavisor string on port 6543
DATABASE_URL="postgresql://user:password@host:5432/hiring_portal"

# The DIRECT (unpooled) string. Migrations run against this instead, because DDL over a
# transaction pooler fails on advisory locks and prepared statements. Used only by the build —
# never by the running app. Leave unset if your database isn't pooled (e.g. local development).
DIRECT_DATABASE_URL=""

# --- The app ---------------------------------------------------------------

# Signs session cookies. Generate with: openssl rand -base64 48
# Changing this signs everyone out.
SESSION_SECRET="change-me-to-at-least-32-random-characters"

# Public URL of this deployment, including https://. Used to build the links inside invite and
# password-reset emails.
#
# Optional on Vercel: if left blank the portal uses VERCEL_PROJECT_PRODUCTION_URL, which Vercel
# sets automatically to your production domain. Set it explicitly once you have a real domain.
# Settings → Integrations shows the address the portal actually resolved.
APP_URL=""

# --- Resume storage (Google Drive) -----------------------------------------
#
# Resumes live in a folder inside a Google Shared Drive. A Shared Drive specifically: a service
# account has no storage quota of its own, so writing into a personal My Drive folder fails with
# 403 storageQuotaExceeded.
#
# Setup: enable the Google Drive API, create a Shared Drive, add the service account as a
# Content manager, then paste the folder's id below.

GOOGLE_SERVICE_ACCOUNT_EMAIL="portal@your-project.iam.gserviceaccount.com"
# Paste the whole private key including the BEGIN/END lines. Literal \n is handled.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# From the folder's URL: drive.google.com/drive/folders/<THIS PART>
GOOGLE_DRIVE_FOLDER_ID=""

# --- First administrator ---------------------------------------------------
#
# Read by the seed, which runs as part of every deploy. The stages and your login are created on
# the first deploy that has a database; after that the seed leaves them alone.
#
# SEED_ADMIN_PASSWORD stops being read once the account exists — delete it after you first log
# in. The build log tells you when that has happened. Without it set, a deploy refuses to create
# an administrator rather than falling back to a default password.

SEED_ADMIN_EMAIL="you@yourcompany.com"
SEED_ADMIN_PASSWORD=""
# Optional — defaults to "Portal Admin".
SEED_ADMIN_NAME=""

# --- Careers site --------------------------------------------------------
#
# The shared secret your careers page sends as X-API-Key when it posts an application.
# Generate with: openssl rand -hex 32
# Until this is set, every /api/public route refuses. See docs/CAREERS-API.md.

CAREERS_API_KEY=""

# ---------------------------------------------------------------------------
# Optional — leave blank to run without it
# ---------------------------------------------------------------------------

# Email (Resend) — invites, password resets, stage notifications.
# Without a key, emails are recorded in the email_log table as SKIPPED and the UI offers a
# copyable invite link instead. That is a perfectly workable way to run the portal.
RESEND_API_KEY=""
EMAIL_FROM="Hiring Portal <hiring@yourdomain.com>"
